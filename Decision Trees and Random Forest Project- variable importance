   "source": [
    "en_cat = ['pub.rec_group', 'inq.last.6mths_group', 'delinq.2yrs_group', 'purpose_group','credit.policy']\n",
    "num_col = ['int.rate', 'installment', 'log.annual.inc', 'dti','fico', 'days.with.cr.line', 'revol.bal', 'revol.util']\n",
