   "metadata": {},
   "outputs": [],
   "source": [
    "## Setting Pipeline\n",
    "cat_trans = Pipeline([('cat', OneHotEncoder(drop='first'))])\n",
    "numeric_trans = Pipeline([('scaling',RobustScaler())])\n",
    "\n",
    "##specifying\n",
    "pre_pipe = ColumnTransformer([ ('cat',cat_trans,en_cat), ('non_cat',numeric_trans,num_col)])"
